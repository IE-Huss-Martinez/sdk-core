{
  "name": "@hussmartinez/sdk-config",
  "version": "0.0.0",
  "description": "Shared development configuration for the @hussmartinez SDK family.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hussmartinez/sdk-core.git",
    "directory": "packages/sdk-config"
  },
  "type": "module",
  "exports": {
    "./biome": "./biome/base.jsonc",
    "./stylelint": "./src/stylelint/index.js",
    "./tsconfig/*": "./tsconfig/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "biome",
    "src",
    "tsconfig",
    "!src/**/*.test.js"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "postcss-selector-parser": "catalog:",
    "postcss-value-parser": "catalog:"
  },
  "peerDependencies": {
    "@biomejs/biome": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "postcss": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
