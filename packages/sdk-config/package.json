{
  "name": "@hussmartinez/sdk-config",
  "version": "0.4.0",
  "description": "Shared development configuration for the @hussmartinez SDK family.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ie-huss-martinez/sdk-core.git",
    "directory": "packages/sdk-config"
  },
  "bugs": {
    "url": "https://github.com/ie-huss-martinez/sdk-core/issues"
  },
  "homepage": "https://github.com/ie-huss-martinez/sdk-core/tree/main/packages/sdk-config#readme",
  "type": "module",
  "bin": {
    "hm-check-api-reports": "./src/api-extractor/cli.js",
    "hm-lint-deps": "./src/dependency-cruiser/cli.js"
  },
  "exports": {
    "./api-extractor/base.json": "./api-extractor/base.json",
    "./biome": "./biome/base.jsonc",
    "./commitlint": "./src/commitlint/index.js",
    "./dependency-cruiser": "./src/dependency-cruiser/index.js",
    "./formats/hm-conformance/v1.schema.json": "./formats/hm-conformance/v1.schema.json",
    "./lint-staged": "./src/lint-staged/index.js",
    "./package.json": "./package.json",
    "./secretlint": "./src/secretlint/index.js",
    "./stylelint": "./src/stylelint/index.js",
    "./testing/audio-output": "./src/testing/audio-output.js",
    "./testing/conformance": "./src/testing/conformance.js",
    "./tsconfig/*": "./tsconfig/*.json"
  },
  "files": [
    "api-extractor",
    "biome",
    "formats",
    "src",
    "tsconfig",
    "!src/**/*.test.js"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "vitest run --project unit",
    "check:package": "publint run --pack pnpm --strict && attw --pack . --profile esm-only",
    "test:browser": "vitest run --project browser",
    "test:browser:all": "vitest run --project browser --mode all-browsers"
  },
  "dependencies": {
    "@commitlint/config-conventional": "catalog:",
    "@secretlint/secretlint-rule-preset-recommend": "catalog:",
    "postcss-selector-parser": "catalog:",
    "postcss-value-parser": "catalog:"
  },
  "peerDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@commitlint/cli": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "ajv": "catalog:",
    "dependency-cruiser": "catalog:",
    "lint-staged": "catalog:",
    "secretlint": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "@biomejs/biome": {
      "optional": true
    },
    "@commitlint/cli": {
      "optional": true
    },
    "@microsoft/api-extractor": {
      "optional": true
    },
    "ajv": {
      "optional": true
    },
    "dependency-cruiser": {
      "optional": true
    },
    "lint-staged": {
      "optional": true
    },
    "secretlint": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/lint": "catalog:",
    "@commitlint/load": "catalog:",
    "@commitlint/types": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@secretlint/node": "catalog:",
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "ajv": "catalog:",
    "dependency-cruiser": "catalog:",
    "lint-staged": "catalog:",
    "picomatch": "catalog:",
    "playwright": "catalog:",
    "postcss": "catalog:",
    "publint": "catalog:",
    "secretlint": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
