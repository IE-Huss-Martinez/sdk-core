{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ie-huss-martinez/sdk-core/blob/main/packages/sdk-config/formats/hm-conformance/v1.schema.json",
  "title": "hm-conformance, version 1",
  "description": "A file of language-neutral conformance cases for one subject's deterministic logic (sdk-core ADR 0045). Each case's input and expected result are the subject's own; this schema checks the envelope.",
  "type": "object",
  "required": ["format", "version", "subject", "cases"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "hm-conformance" },
    "version": { "const": 1 },
    "subject": {
      "description": "What the cases test, named like a format: hm-<kind>-<thing>, such as hm-video-commands.",
      "type": "string",
      "pattern": "^hm-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "input", "expected"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "input": true,
        "expected": true,
        "tolerance": {
          "description": "The largest absolute difference allowed for every number in the result, for computed floats only (ADR 0045, section 3). Without it, numbers compare exactly.",
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "error": {
      "description": "An expected rejection: compared by code and reason, never by message text.",
      "type": "object",
      "required": ["error"],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "required": ["code"],
          "additionalProperties": false,
          "properties": {
            "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "reason": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
          }
        }
      }
    }
  }
}
