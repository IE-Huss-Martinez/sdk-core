{
  "name": "@hussmartinez/sdk-core",
  "version": "0.1.3",
  "description": "Headless runtime shared by the @hussmartinez SDK family.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ie-huss-martinez/sdk-core.git",
    "directory": "packages/sdk-core"
  },
  "bugs": {
    "url": "https://github.com/ie-huss-martinez/sdk-core/issues"
  },
  "homepage": "https://github.com/ie-huss-martinez/sdk-core/tree/main/packages/sdk-core#readme",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "build": "vite build && pnpm check:api",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:browser:all": "vitest run --project browser --mode all-browsers",
    "check:api": "tsc -p tsconfig.build.json && api-extractor run",
    "check:package": "publint run --pack pnpm --strict && attw --pack . --profile esm-only",
    "api:update": "tsc -p tsconfig.build.json && api-extractor run --local"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@hussmartinez/sdk-config": "workspace:*",
    "@microsoft/api-extractor": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "esbuild": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
